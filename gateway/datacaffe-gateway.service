[Unit]
Description=DataCaffe LLM Gateway
After=network.target

[Service]
Type=exec
User=brewai
Group=brewai
WorkingDirectory=/opt/datacaffe-gateway

# Environment — edit these
Environment=OLLAMA_URL=http://127.0.0.1:11434
Environment=DB_PATH=/opt/datacaffe-gateway/keys.db
Environment=ALLOWED_MODELS=qwen3.5:27b,devstral:24b,qwen3:14b

# REQUIRED: generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
EnvironmentFile=/opt/datacaffe-gateway/.env

ExecStart=/opt/datacaffe-gateway/venv/bin/uvicorn app:app \
    --host 127.0.0.1 \
    --port 8001 \
    --workers 2 \
    --log-level info

Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=datacaffe-gateway

NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
