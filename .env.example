# ──────────────────────────────────────────────
# BrewAI Environment Configuration
# Copy to .env and fill in your values
# ──────────────────────────────────────────────

# PostgreSQL
POSTGRES_USER=brewai
POSTGRES_PASSWORD=changeme_strong_password
POSTGRES_DB=brewai
# DATABASE_URL is auto-constructed in docker-compose from the above

# Ollama — your GPU droplet
# Make sure port 11434 is accessible from this server
OLLAMA_HOST=http://YOUR_GPU_DROPLET_IP:11434
OLLAMA_MODEL=bazobehram/qwen3-14b-claude-4.5-opus-high-reasoning
OLLAMA_TIMEOUT=300

# Auth — generate a strong random key:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_64_CHAR_HEX_STRING
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Fine-tune trigger — HTTP endpoint on your GPU server
# Set up a simple FastAPI/Flask endpoint there to receive training jobs
GPU_SERVER_FINETUNE_URL=http://YOUR_GPU_DROPLET_IP:8080/finetune
MIN_TRAINING_EXAMPLES=10

# CORS — add your domain if deploying to production
# CORS_ORIGINS=["http://localhost:3000","https://brewai.yourcompany.com"]

# Grafana
GRAFANA_ADMIN_PASSWORD=changeme_strong_password

# Debug (set to false in production)
DEBUG=false
